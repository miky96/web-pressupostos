# Copia aquest fitxer a .env.local (ignorat per git) i omple'l amb la config de l'app web de Firebase
# (Consola > Configuració del projecte > Les teves apps > SDK setup and configuration).
# No són secrets (acaben al JS públic), però així no queden lligats al repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=EL-TEU-PROJECT-ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=EL-TEU-PROJECT-ID
VITE_FIREBASE_APP_ID=

# true = connecta als emuladors locals (npm run emulators) en lloc del projecte real
VITE_USE_EMULATORS=false

# --- Només per a la CLI (scripts/firebase.mjs). Sense prefix VITE_: no arriben mai al navegador. ---
# Compte de Google amb què es desplega (ha d'estar connectat: npx firebase login:add)
FIREBASE_ACCOUNT=el-teu-correu@gmail.com
# Correus que poden fer servir l'app, separats per comes (llista blanca de firestore.rules)
ALLOWED_EMAILS=el-teu-correu@gmail.com
